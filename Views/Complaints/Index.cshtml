@model IEnumerable<Complaint>
@{
    ViewData["Title"] = "Complaints";
}
<div class="page-title-row reveal">
    <div><span class="section-kicker">CAMPUS CARE CENTER</span><h1>Complaints</h1><p class="page-subtitle">Track reports, check progress, and help keep campus running smoothly.</p></div>
    <a asp-action="Create" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i> New complaint</a>
</div>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
}
@if (ViewBag.LastComplaintId != null)
{
    <div class="alert alert-info"><i class="bi bi-bookmark-check me-2"></i>Your most recently submitted complaint ID is <strong>#@ViewBag.LastComplaintId</strong>.</div>
}
<form method="get" class="content-card p-3 p-md-4 mb-4 reveal">
    <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-funnel text-primary"></i><strong>Find a report</strong><span class="text-muted small ms-auto">Use filters to narrow results</span></div>
    <div class="row g-2">
        <div class="col-12 col-md-5"><label class="form-label small" for="search">Search</label><input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search title or location…" /></div>
        <div class="col-6 col-md-3"><label class="form-label small" for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (string s in new[] { "Pending", "In Progress", "Resolved" }) { <option value="@s" selected="@(ViewBag.SelectedStatus as string == s)">@s</option> }</select></div>
        <div class="col-6 col-md-2"><label class="form-label small" for="category">Category</label><select id="category" name="category" class="form-select"><option value="">All categories</option>@foreach (string c in (string[])ViewBag.Categories) { <option value="@c" selected="@(ViewBag.SelectedCategory as string == c)">@c</option> }</select></div>
        <div class="col-12 col-md-2 d-grid align-self-end"><button class="btn btn-brand"><i class="bi bi-search me-1"></i> Filter</button></div>
    </div>
</form>
<div class="content-card overflow-hidden reveal">
    <div class="d-flex justify-content-between align-items-center p-3 p-md-4 border-bottom"><div><h2 class="h5 mb-1 fw-bold">All reports</h2><p class="text-muted small mb-0">@Model.Count() report(s) found</p></div><span class="panel-heading-icon"><i class="bi bi-clipboard2-check"></i></span></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Issue</th><th>Location</th><th>Category</th><th>Priority</th><th>Status</th><th>Reported</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><div class="fw-bold">@item.Title</div><div class="small text-muted">Report #@item.Id</div></td><td><i class="bi bi-geo-alt text-muted me-1"></i>@item.Location</td><td>@item.Category</td>
                    <td><span class="priority-label priority-@item.Priority.ToLowerInvariant()">@item.Priority</span></td>
                    <td><span class="status-pill status-@(item.Status == "Resolved" ? "resolved" : item.Status == "In Progress" ? "progress" : "pending")"><span></span>@item.Status</span></td><td class="text-nowrap">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td class="text-end text-nowrap"><div class="dropdown"><button class="btn btn-sm action-menu" data-bs-toggle="dropdown" aria-label="Actions for @item.Title"><i class="bi bi-three-dots"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye me-2"></i>View details</a></li><li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil me-2"></i>Edit report</a></li><li><hr class="dropdown-divider" /></li><li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash me-2"></i>Delete</a></li></ul></div></td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="7"><div class="empty-state"><i class="bi bi-inbox"></i><strong class="d-block text-body mb-1">No reports found</strong><span>Try changing your filters, or create the first report.</span><div class="mt-3"><a asp-action="Create" class="btn btn-brand btn-sm"><i class="bi bi-plus-lg me-1"></i> Create report</a></div></div></td></tr> }
            </tbody>
        </table>
    </div>
</div>
