<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7ff" />
    <title>@ViewData["Title"] · CampusFix</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container-xl">
            <a class="navbar-brand brand-mark" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-buildings-fill"></i></span>
                <span>Campus<span class="brand-accent">Fix</span><small>Campus care, simplified</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-1"></i> Overview</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Complaints" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Complaints" asp-action="Index"><i class="bi bi-list-check me-1"></i> Complaints</a>
                    <a class="btn btn-brand ms-lg-2" asp-controller="Complaints" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> Report an issue</a>
                    <button type="button" class="theme-toggle ms-lg-2" id="themeToggle" aria-label="Toggle dark mode" title="Toggle theme"><i class="bi bi-moon-stars"></i></button>
                </div>
            </div>
        </div>
    </nav>
</header>
<main class="container-xl page-shell">
    @RenderBody()
</main>
<footer class="site-footer">
    <div class="container-xl d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
        <div class="footer-brand"><span class="brand-icon brand-icon-sm"><i class="bi bi-buildings-fill"></i></span> <strong>CampusFix</strong> <span class="text-muted">· Making campus better, one fix at a time.</span></div>
        <span class="footer-note"><i class="bi bi-heart-fill me-1"></i> Built for a better campus</span>
    </div>
</footer>
<div id="toastHost" class="toast-host" aria-live="polite" aria-atomic="true"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
